        {
          "id": "D1",
          "name": "Opaque alias reconstruction rewrites uncaptured bivariant lifetimes to 'static, altering preserved lifetime relationships",
          "code_elements": [
            {
              "type": "FUNCTION",
              "name": "fold_ty",
              "file": "compiler/rustc_borrowck/src/region_infer/mod.rs",
              "content": "fn fold_ty(&mut self, t: Ty<'tcx>) -> Ty<'tcx> {\n                use ty::TypeSuperFoldable as _;\n                let tcx = self.tcx;\n                let &ty::Alias(ty::Opaque, ty::AliasTy { args, def_id, .. }) = t.kind() else {\n                    return t.super_fold_with(self);\n                };\n                let args = std::iter::zip(args, tcx.variances_of(def_id)).map(|(arg, v)| {\n                    match (arg.unpack(), v) {\n                        (ty::GenericArgKind::Lifetime(_), ty::Bivariant) => {\n                            tcx.lifetimes.re_static.into()\n                        }\n                        _ => arg.fold_with(self),\n                    }\n                });\n                Ty::new_opaque(tcx, def_id, tcx.mk_args_from_iter(args))\n            }"
            }
          ]
        }
      ],
