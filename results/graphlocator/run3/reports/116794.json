              "content": "pub fn new_opaque(tcx: TyCtxt<'tcx>, def_id: DefId, args: GenericArgsRef<'tcx>) -> Ty<'tcx> {\n        Ty::new_alias(tcx, ty::Opaque, tcx.mk_alias_ty(def_id, args))\n    }"
