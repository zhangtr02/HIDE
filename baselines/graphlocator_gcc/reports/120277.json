      "nodes": [
        {
          "id": "A",
          "name": "Poly-int upper_bound mixes scalar bound with nonnegative higher coefficients",
          "code_elements": [
            {
              "type": "FUNCTION",
              "name": "upper_bound",
              "file": "gcc/poly-int.h",
              "content": "upper_bound (const poly_int<N, Ca> &a, const Cb &b)\n{\n  typedef POLY_CAST (Ca, Cb) NCa;\n  typedef POLY_CAST (Cb, Ca) NCb;\n  typedef POLY_INT_TYPE (Cb) ICb;\n  typedef POLY_CONST_COEFF (Ca, Cb) C;\n\n  poly_int<N, C> r;\n  POLY_SET_COEFF (C, r, 0, MAX (NCa (a.coeffs[0]), NCb (b)));\n  if (N >= 2)\n    for (unsigned int i = 1; i < N; i++)\n      POLY_SET_COEFF (C, r, i, MAX (NCa (a.coeffs[i]), ICb (0)));\n  return r;\n}"
            }
          ]
        },
        {
          "id": "I",
          "name": "Issue",
          "code_elements": []
        },
        {
          "id": "B",
          "name": "Symmetric upper_bound overload propagates the same faulty bound logic through argument reversal",
          "code_elements": [
            {
              "type": "FUNCTION",
              "name": "upper_bound",
              "file": "gcc/poly-int.h",
              "content": "upper_bound (const Ca &a, const poly_int<N, Cb> &b)\n{\n  return upper_bound (b, a);\n}"
            }
          ]
        },
        {
          "id": "C",
          "name": "Poly-int pairwise upper_bound can produce incompatible bounds during range-op folding",
          "code_elements": [
            {
              "type": "FUNCTION",
              "name": "upper_bound",
              "file": "gcc/poly-int.h",
              "content": "upper_bound (const poly_int<N, Ca> &a, const poly_int<N, Cb> &b)\n{\n  typedef POLY_CAST (Ca, Cb) NCa;\n  typedef POLY_CAST (Cb, Ca) NCb;\n  typedef POLY_POLY_COEFF (Ca, Cb) C;\n\n  poly_int<N, C> r;\n  for (unsigned int i = 0; i < N; i++)\n    POLY_SET_COEFF (C, r, i, MAX (NCa (a.coeffs[i]), NCb (b.coeffs[i])));\n  return r;\n}"
            }
          ]
        },
        {
