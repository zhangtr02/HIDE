          "id": "A",
          "name": "Signed addressing IV normalized as a generic IV with zero base",
          "code_elements": [
            {
              "type": "FUNCTION",
              "name": "get_iv",
              "file": "gcc/tree-ssa-loop-ivopts.cc",
              "content": "static struct iv *\nget_iv (struct ivopts_data *data, tree var)\n{\n  basic_block bb;\n  tree type = TREE_TYPE (var);\n\n  if (!POINTER_TYPE_P (type)\n      && !INTEGRAL_TYPE_P (type))\n    return NULL;\n\n  if (!name_info (data, var)->iv)\n    {\n      bb = gimple_bb (SSA_NAME_DEF_STMT (var));\n\n      if (!bb\n\t  || !flow_bb_inside_loop_p (data->current_loop, bb))\n\t{\n\t  if (POINTER_TYPE_P (type))\n\t    type = sizetype;\n\t  set_iv (data, var, var, build_int_cst (type, 0), true);\n\t}\n    }\n\n  return name_info (data, var)->iv;\n}"
            }
          ]
        },
        {
          "id": "I",
          "name": "Issue",
          "code_elements": []
        },
        {
          "id": "B",
          "name": "Pointer/non-pointer IV type coercion loses signed offset information needed for immediate addressing",
          "code_elements": [
            {
              "type": "FUNCTION",
              "name": "get_iv",
              "file": "gcc/tree-ssa-loop-ivopts.cc",
              "content": "static struct iv *\nget_iv (struct ivopts_data *data, tree var)\n{\n  basic_block bb;\n  tree type = TREE_TYPE (var);\n\n  if (!POINTER_TYPE_P (type)\n      && !INTEGRAL_TYPE_P (type))\n    return NULL;\n\n  if (!name_info (data, var)->iv)\n    {\n      bb = gimple_bb (SSA_NAME_DEF_STMT (var));\n\n      if (!bb\n\t  || !flow_bb_inside_loop_p (data->current_loop, bb))\n\t{\n\t  if (POINTER_TYPE_P (type))\n\t    type = sizetype;\n\t  set_iv (data, var, var, build_int_cst (type, 0), true);\n\t}\n    }\n\n  return name_info (data, var)->iv;\n}"
            }
          ]
        },
        {
          "id": "C",
          "name": "IV recognition outside the loop falls back to a synthetic IV, steering addressing toward register offsets",
          "code_elements": [
            {
              "type": "FUNCTION",
              "name": "get_iv",
              "file": "gcc/tree-ssa-loop-ivopts.cc",
              "content": "static struct iv *\nget_iv (struct ivopts_data *data, tree var)\n{\n  basic_block bb;\n  tree type = TREE_TYPE (var);\n\n  if (!POINTER_TYPE_P (type)\n      && !INTEGRAL_TYPE_P (type))\n    return NULL;\n\n  if (!name_info (data, var)->iv)\n    {\n      bb = gimple_bb (SSA_NAME_DEF_STMT (var));\n\n      if (!bb\n\t  || !flow_bb_inside_loop_p (data->current_loop, bb))\n\t{\n\t  if (POINTER_TYPE_P (type))\n\t    type = sizetype;\n\t  set_iv (data, var, var, build_int_cst (type, 0), true);\n\t}\n    }\n\n  return name_info (data, var)->iv;\n}"
            }
          ]
